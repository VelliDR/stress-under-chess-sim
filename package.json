{
  "name": "stress-under-chess-sim",
  "description": "Stress Under Chess Simulator (S.U.C.S.) — A tactical roguelike chess sim that literally S.U.C.S.",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "author": "VelliDR",
  "repository": {
    "type": "git",
    "url": "https://github.com/VelliDR/stress-under-chess-sim.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.engine.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "arena": "vite-node --script scripts/arena.ts",
    "train": "vite-node --script scripts/train.ts",
    "train:overnight": "vite-node --script scripts/overnight.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
